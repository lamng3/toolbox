#!/bin/bash
# Generated by `toolbox launch` — edit the launcher config, not this file.
#SBATCH --job-name=${job_name}
#SBATCH --nodes=${nodes}
#SBATCH --ntasks-per-node=1
#SBATCH --gpus-per-node=${gpus_per_node}
#SBATCH --cpus-per-task=${cpus_per_task}
#SBATCH --mem=${mem}
#SBATCH --time=${time}
#SBATCH --output=${log_dir}/%x-%j.out
#SBATCH --error=${log_dir}/%x-%j.err
#SBATCH --signal=USR1@${preempt_signal_seconds}
${optional_directives}
set -euo pipefail

echo "[toolbox] job $$SLURM_JOB_ID on $$(hostname) at $$(date)"
${setup}
${env_exports}

# Rendezvous: the first node of the allocation hosts the torch.distributed store.
export MASTER_ADDR=$$(scontrol show hostnames "$$SLURM_JOB_NODELIST" | head -n 1)
export MASTER_PORT=${master_port}
export OMP_NUM_THREADS=${omp_threads}

# On preemption SLURM sends USR1; requeue so `trainer.resume_from=auto` continues the run.
trap 'echo "[toolbox] caught USR1, requeueing"; scontrol requeue $$SLURM_JOB_ID' USR1

srun --kill-on-bad-exit=1 torchrun \
  --nnodes=${nodes} \
  --nproc-per-node=${gpus_per_node} \
  --rdzv-backend=c10d \
  --rdzv-endpoint=$$MASTER_ADDR:$$MASTER_PORT \
  --rdzv-id=$$SLURM_JOB_ID \
  -m toolbox.cli train ${overrides} &
wait
